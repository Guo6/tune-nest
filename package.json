{
  "name": "tune-nest",
  "version": "0.1.9",
  "description": "网易云音乐与 QQ 音乐智能歌单分类桌面应用",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "test": "vitest run",
    "build": "tauri build",
    "dev:frontend": "vite --config vite.desktop.config.ts",
    "build:frontend": "tsc -p tsconfig.json && vite build --config vite.desktop.config.ts",
    "extension:build": "tsc -p tsconfig.json && vite build --config vite.extension.config.ts",
    "preview": "vite preview --config vite.desktop.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "crypto-js": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@tauri-apps/cli": "^2.12.4",
    "@types/chrome": "^0.0.268",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^25.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
