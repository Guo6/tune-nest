{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TuneNest",
  "version": "0.1.8",
  "identifier": "com.tunenest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TuneNest",
        "width": 1120,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "category": "Music",
    "shortDescription": "网易云音乐与 QQ 音乐智能歌单整理工具",
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
